// Generated by mazapan (plugin {{ plugin }}): the news, for the shell.
//
// The helper (~/.local/share/mazapan/bin/news) fetches each source's feed
// from Google News and keeps what came; this shows what it kept at once,
// asks it for news now and then (and when the internet comes back), keeps
// your sources through it, and says how many headlines came since you last
// looked (the bar's dot).

pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Hyprland
import qs

Singleton {
  id: root

  // --- the settings, read live ------------------------------------------------

  readonly property var settings: Object.assign({ bar: true, dot: true, every: 30, per_source: 20 }, stored)
  property var stored: ({})
  FileView {
    path: Quickshell.shellPath("components/news/settings.json")
    blockLoading: true
    watchChanges: true
    printErrors: false
    onFileChanged: reload()
    onLoaded: { try { root.stored = JSON.parse(text()) } catch (e) {} }
  }

  // --- what came ----------------------------------------------------------------

  readonly property string bin: Quickshell.env("HOME") + "/.local/share/mazapan/bin/news"
  property var items: []
  property var sources: []
  property var errors: ({})
  property int fetched: 0          // when it last looked (seconds)
  property int seen: 0             // read up to here: newer ones are new
  property bool loaded: false
  property bool loading: false
  property bool panelOpen: false

  readonly property int fresh: items.filter(i => isNew(i)).length
  function isNew(i) { return i.first_seen > seen }

  // A source's own headlines (the first source a story came from counts).
  function of(sid) { return sid ? items.filter(i => i.from.includes(sid)) : items }
  function source(sid) { return sources.find(s => s.id === sid) || null }

  function take(text) {
    now = Date.now() / 1000
    try {
      const d = JSON.parse(text)
      root.items = d.items || []
      root.sources = d.sources || []
      root.errors = d.errors || {}
      root.fetched = d.fetched || 0
      root.seen = d.seen || 0
      root.loaded = true
    } catch (e) {}
  }

  // What was kept: no network, at once.
  Process {
    id: shower
    command: ["python3", "-I", root.bin, "show", "--limit", String(root.settings.per_source)]
    stdout: StdioCollector {
      onStreamFinished: {
        root.take(text)
        if (Date.now() / 1000 - root.fetched > root.settings.every * 60) root.refresh()
      }
    }
  }

  Process {
    id: fetcher
    command: ["python3", "-I", root.bin, "fetch", "--limit", String(root.settings.per_source)]
    stdout: StdioCollector { onStreamFinished: root.take(text) }
    onExited: root.loading = false
  }
  function refresh() {
    if (fetcher.running) return
    loading = true
    fetcher.running = true
  }

  Component.onCompleted: { shower.running = true; browserFinder.running = true }

  // Every `every` minutes; and when the internet comes back.
  Timer {
    interval: Math.max(10, root.settings.every) * 60 * 1000
    running: true
    repeat: true
    onTriggered: root.refresh()
  }
  Connections {
    target: Online
    function onBack() { root.refresh() }
  }

  // Looked at: the dot goes once the panel closes.
  Process { id: marker; stdout: StdioCollector { onStreamFinished: { try { root.seen = JSON.parse(text).seen } catch (e) {} } } }
  onPanelOpenChanged: if (!panelOpen && fresh > 0 && !marker.running) {
    marker.command = ["python3", "-I", bin, "seen"]
    marker.running = true
  }

  // --- your sources -------------------------------------------------------------

  property var editions: []
  Process {
    id: editionLister
    command: ["python3", "-I", root.bin, "editions"]
    stdout: StdioCollector { onStreamFinished: { try { root.editions = JSON.parse(text) } catch (e) {} } }
  }
  function loadEditions() { if (!editions.length && !editionLister.running) editionLister.running = true }

  Process {
    id: saver
    stdout: StdioCollector {
      onStreamFinished: { try { root.sources = JSON.parse(text) } catch (e) {} }
    }
  }
  // Each { edition, topic } or { edition, query }; the helper keeps what's right.
  function setSources(list) {
    const plain = list.map(s => s.query ? { edition: s.edition, query: s.query } : { edition: s.edition, topic: s.topic })
    sources = plain.map(s => Object.assign({ id: s.edition + "/" + (s.query ? "q:" + s.query : s.topic), country: s.edition.split(":")[0], lang: s.edition.split(":")[1] }, s))
    saver.command = ["python3", "-I", bin, "set-sources", JSON.stringify(plain)]
    saver.running = true
  }

  // Opened in the browser, and the browser brought forward: it opens the
  // link in its window, wherever that is (another workspace), and stays
  // there otherwise.
  property string browser: ""
  Process {
    id: browserFinder
    command: ["python3", "-I", root.bin, "browser"]
    stdout: StdioCollector { onStreamFinished: { try { root.browser = JSON.parse(text).class || "" } catch (e) {} } }
  }
  function openUrl(url) {
    if (!/^https:\/\//.test(url || "")) return
    Quickshell.execDetached(["xdg-open", url])
    if (browser) goToBrowser.restart()
    else if (!browserFinder.running) browserFinder.running = true
  }
  Timer {
    id: goToBrowser
    interval: 450
    onTriggered: Hyprland.dispatch(`hl.dsp.focus({ window = ${JSON.stringify("class:^(" + root.browser.replace(/[^\w.-]/g, "") + ")$")} })`)
  }

  IpcHandler {
    target: "news"
    function refresh(): void { root.refresh() }
  }

  // --- how things are said ------------------------------------------------------------

  readonly property var topics: ({
    TOP: {{ tq "topic.TOP" }}, NATION: {{ tq "topic.NATION" }}, WORLD: {{ tq "topic.WORLD" }},
    BUSINESS: {{ tq "topic.BUSINESS" }}, TECHNOLOGY: {{ tq "topic.TECHNOLOGY" }},
    SCIENCE: {{ tq "topic.SCIENCE" }}, HEALTH: {{ tq "topic.HEALTH" }},
    ENTERTAINMENT: {{ tq "topic.ENTERTAINMENT" }}, SPORTS: {{ tq "topic.SPORTS" }}
  })
  readonly property var sectionOrder: ["TOP", "NATION", "WORLD", "BUSINESS", "TECHNOLOGY", "SCIENCE", "HEALTH", "ENTERTAINMENT", "SPORTS"]

  // A country's flag, from its two letters.
  function flag(cc) {
    if (!cc || cc.length !== 2) return ""
    return String.fromCodePoint(0x1F1E6 + cc.charCodeAt(0) - 65, 0x1F1E6 + cc.charCodeAt(1) - 65)
  }

  // A country's name in the desktop's language.
  readonly property var countries: ({
{{- for c in ["AE","AR","AT","AU","BD","BE","BG","BR","BW","CA","CH","CL","CN","CO","CU","CZ","DE","EE","EG","ES","ET","FI","FR","GB","GH","GR","HK","HU","ID","IE","IL","IN","IT","JP","KE","KR","LB","LT","LV","MA","MX","MY","NA","NG","NL","NO","NZ","PE","PH","PK","PL","PT","RO","RS","RU","SA","SE","SG","SI","SK","SN","TH","TR","TW","TZ","UA","UG","US","VE","VN","ZA","ZW"] }}
    {{ c }}: {{ tq ("c." + c) }},
{{- end }}
  })
  function country(cc) { return countries[cc] || cc }

  // A language by its own name (Español, 日本語, English): the country
  // beside it already says which Spanish.
  readonly property var languages: ({
    ar: "العربية", bg: "Български", bn: "বাংলা", cs: "Čeština", de: "Deutsch", el: "Ελληνικά",
    en: "English", es: "Español", et: "Eesti", fi: "Suomi", fr: "Français", he: "עברית",
    hi: "हिन्दी", hu: "Magyar", id: "Bahasa Indonesia", it: "Italiano", ja: "日本語", ko: "한국어",
    lt: "Lietuvių", lv: "Latviešu", ml: "മലയാളം", mr: "मराठी", ms: "Bahasa Melayu", nl: "Nederlands",
    no: "Norsk", pl: "Polski", pt: "Português", ro: "Română", ru: "Русский", sk: "Slovenčina",
    sl: "Slovenščina", sr: "Српски", sv: "Svenska", ta: "தமிழ்", te: "తెలుగు", th: "ไทย",
    tr: "Türkçe", uk: "Українська", vi: "Tiếng Việt", "zh-Hans": "简体中文", "zh-Hant": "繁體中文"
  })
  function language(lang) { return languages[lang] || languages[(lang || "").split("-")[0]] || lang }

  // What a source is called: its section, or its words.
  function topicOf(s) { return !s ? "" : s.query ? s.query : (topics[s.topic] || s.topic) }
  // The country too, when your sources are from more than one.
  readonly property bool manyCountries: new Set(sources.map(s => s.country)).size > 1

  // "5 min ago" moves on by itself.
  property real now: Date.now() / 1000
  Timer { interval: 30000; running: true; repeat: true; onTriggered: root.now = Date.now() / 1000 }

  function ago(ts) {
    if (!ts) return ""
    const d = Math.max(0, now - ts)
    if (d < 90) return {{ tq "ago.now" }}
    if (d < 3600) return {{ tq "ago.min" }}.arg(Math.round(d / 60))
    if (d < 86400) return {{ tq "ago.hour" }}.arg(Math.floor(d / 3600))
    return {{ tq "ago.day" }}.arg(Math.floor(d / 86400))
  }
}
