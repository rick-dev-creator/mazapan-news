#!/usr/bin/env python3
# Generated by mazapan (plugin {{ plugin }}): the news, from Google News.
#
#   news show [--limit N]     what was fetched last, as JSON (nothing fetched)
#   news fetch [--limit N]    every source fetched again, then as `show`
#   news sources              your sources (the system's country, until you pick)
#   news set-sources JSON     your sources, checked and kept, as `sources`
#   news seen                 everything fetched so far read: the bar's dot goes
#   news editions             the editions Google News has, by country and language
#   news browser              the default browser's window class, to go to it
#
# A source is an edition (a country in one of its languages: MX:es-419,
# JP:ja) and either one of Google's sections (TOP, NATION, SCIENCE…) or
# words to search for (inteligencia artificial, bitcoin). Each is one RSS
# feed at news.google.com: asked over https only, for 10 seconds at most,
# 1 MB at most. Nothing else is sent: no account, no identifier. What came
# back is kept in ~/.local/state/mazapan/news. Run as `python3 -I`: only
# Python's own library.

import concurrent.futures
import email.utils
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET

HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".local/state/mazapan/news")
SOURCES = os.path.join(STATE, "sources.json")
HEADLINES = os.path.join(STATE, "headlines.json")
SEEN = os.path.join(STATE, "seen.json")

# The desktop's language, as Mazapan says it (es_MX); the environment's if
# that's empty. Only for the first sources, before you pick yours.
LANG = {{ quote lang }}

MAX_BYTES = 1024 * 1024
TIMEOUT = 10
MAX_SOURCES = 12
MAX_QUERY = 80
DEFAULT_LIMIT = 20
MAX_LIMIT = 50

# Google News' editions: (country, the edition's language, hl). Each one
# checked against news.google.com: asked with this hl, it answers without
# moving elsewhere. A country in a language Google doesn't have (Japan in
# English) isn't an edition: it falls back to the US one, so it isn't here.
EDITIONS = [
    ("AE", "ar", "ar"), ("AR", "es-419", "es-419"), ("AT", "de", "de"),
    ("AU", "en", "en-AU"), ("BD", "bn", "bn"), ("BE", "fr", "fr"),
    ("BE", "nl", "nl"), ("BG", "bg", "bg"), ("BR", "pt-419", "pt-BR"),
    ("BW", "en", "en-BW"), ("CA", "en", "en-CA"), ("CA", "fr", "fr-CA"),
    ("CH", "de", "de"), ("CH", "fr", "fr"), ("CL", "es-419", "es-419"),
    ("CN", "zh-Hans", "zh-CN"), ("CO", "es-419", "es-419"), ("CU", "es-419", "es-419"),
    ("CZ", "cs", "cs"), ("DE", "de", "de"), ("EE", "et", "et-EE"),
    ("EG", "ar", "ar"), ("ES", "es", "es"), ("ET", "en", "en-ET"),
    ("FI", "fi", "fi-FI"), ("FR", "fr", "fr"), ("GB", "en", "en-GB"),
    ("GH", "en", "en-GH"), ("GR", "el", "el"), ("HK", "zh-Hant", "zh-HK"),
    ("HU", "hu", "hu"), ("ID", "id", "id"), ("ID", "en", "en-ID"),
    ("IE", "en", "en-IE"), ("IL", "he", "he"), ("IL", "en", "en-IL"),
    ("IN", "en", "en-IN"), ("IN", "hi", "hi"), ("IN", "bn", "bn"),
    ("IN", "mr", "mr"), ("IN", "ta", "ta"), ("IN", "te", "te"),
    ("IN", "ml", "ml"), ("IT", "it", "it"), ("JP", "ja", "ja"),
    ("KE", "en", "en-KE"), ("KR", "ko", "ko"), ("LB", "ar", "ar"),
    ("LT", "lt", "lt"), ("LV", "lv", "lv"), ("MA", "fr", "fr"),
    ("MX", "es-419", "es-419"), ("MY", "en", "en-MY"), ("MY", "ms", "ms-MY"),
    ("NA", "en", "en-NA"), ("NG", "en", "en-NG"), ("NL", "nl", "nl"),
    ("NO", "no", "no"), ("NZ", "en", "en-NZ"), ("PE", "es-419", "es-419"),
    ("PH", "en", "en-PH"), ("PK", "en", "en-PK"), ("PL", "pl", "pl"),
    ("PT", "pt-150", "pt-PT"), ("RO", "ro", "ro"), ("RS", "sr", "sr"),
    ("RU", "ru", "ru"), ("SA", "ar", "ar"), ("SE", "sv", "sv"),
    ("SG", "en", "en-SG"), ("SI", "sl", "sl"), ("SK", "sk", "sk"),
    ("SN", "fr", "fr"), ("TH", "th", "th"), ("TR", "tr", "tr"),
    ("TW", "zh-Hant", "zh-TW"), ("TZ", "en", "en-TZ"), ("UA", "uk", "uk"),
    ("UA", "ru", "ru"), ("UG", "en", "en-UG"), ("US", "en", "en-US"),
    ("US", "es-419", "es-419"), ("VE", "es-419", "es-419"), ("VN", "vi", "vi"),
    ("ZA", "en", "en-ZA"), ("ZW", "en", "en-ZW"),
]
BY_ID = dict((f"{c}:{l}", (c, l, hl)) for c, l, hl in EDITIONS)

# Google's own sections, the same in every edition (in its language).
# TOP is the edition's front page.
SECTIONS = ["TOP", "NATION", "WORLD", "BUSINESS", "TECHNOLOGY",
            "SCIENCE", "HEALTH", "ENTERTAINMENT", "SPORTS"]


# --- editions and sources ------------------------------------------------------------

def edition_id(country, lang):
    return f"{country}:{lang}"


def _base(lang):
    """The language alone: es-419 → es, zh-Hant → zh, pt-150 → pt."""
    return re.split(r"[-_]", lang or "")[0].lower()


def default_edition(locale):
    """The edition for a locale (es_MX, en_US.UTF-8, ja): its country in its
    language if Google has it; else its country in any language (a person in
    Mexico with English set still lives in Mexico); else its language
    anywhere; else the US in English."""
    locale = (locale or "").split(".")[0].split("@")[0]
    parts = locale.replace("-", "_").split("_")
    lang = parts[0].lower()
    country = parts[1].upper() if len(parts) > 1 and len(parts[1]) == 2 else ""
    if country:
        here = [e for e in EDITIONS if e[0] == country]
        for c, l, _ in here:
            if _base(l) == lang:
                return edition_id(c, l)
        if here:
            return edition_id(here[0][0], here[0][1])
    # A language alone: its home, where there's one obvious.
    homes = {"en": "US", "es": "MX", "pt": "BR", "fr": "FR", "de": "DE", "zh": "CN",
             "ar": "EG", "ja": "JP", "ko": "KR", "it": "IT", "ru": "RU", "nl": "NL"}
    if lang in homes:
        for c, l, _ in EDITIONS:
            if c == homes[lang] and _base(l) == lang:
                return edition_id(c, l)
    for c, l, _ in EDITIONS:
        if _base(l) == lang:
            return edition_id(c, l)
    return "US:en"


def source_id(src):
    if src.get("query"):
        return f"{src['edition']}/q:{src['query']}"
    return f"{src['edition']}/{src['topic']}"


def clean_query(text):
    text = re.sub(r"[\x00-\x1f\x7f]", " ", str(text or ""))
    return re.sub(r"\s+", " ", text).strip()[:MAX_QUERY]


def check_sources(raw):
    """Your sources, as kept: each with a known edition and a section or
    words; the same one twice once; at most MAX_SOURCES. What isn't right is
    left out, never guessed."""
    out, seen = [], set()
    if not isinstance(raw, list):
        return out
    for s in raw:
        if not isinstance(s, dict) or s.get("edition") not in BY_ID:
            continue
        query = clean_query(s.get("query"))
        if query:
            src = {"edition": s["edition"], "query": query}
        elif s.get("topic") in SECTIONS:
            src = {"edition": s["edition"], "topic": s["topic"]}
        else:
            continue
        sid = source_id(src)
        if sid.lower() in seen:
            continue
        seen.add(sid.lower())
        out.append(src)
        if len(out) == MAX_SOURCES:
            break
    return out


def load_json(path, fallback):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return fallback


def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, separators=(",", ":"))
    os.replace(tmp, path)


def sources():
    """Yours; until you've picked any, your country's front page."""
    if os.path.exists(SOURCES):
        return check_sources(load_json(SOURCES, []))
    return [{"edition": default_edition(LANG or os.environ.get("LANG", "")), "topic": "TOP"}]


def described(srcs):
    out = []
    for s in srcs:
        c, l, _ = BY_ID[s["edition"]]
        out.append(dict(s, id=source_id(s), country=c, lang=l))
    return out


# --- a feed --------------------------------------------------------------------------------

def feed_url(src):
    country, lang, hl = BY_ID[src["edition"]]
    tail = urllib.parse.urlencode({"hl": hl, "gl": country, "ceid": f"{country}:{lang}"})
    if src.get("query"):
        # The last two days: a search otherwise brings back years.
        q = urllib.parse.quote(f"{src['query']} when:2d")
        return f"https://news.google.com/rss/search?q={q}&{tail}"
    if src["topic"] == "TOP":
        return f"https://news.google.com/rss?{tail}"
    return f"https://news.google.com/rss/headlines/section/topic/{src['topic']}?{tail}"


class _HttpsOnly(urllib.request.HTTPRedirectHandler):
    max_redirections = 5

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if urllib.parse.urlsplit(newurl).scheme != "https":
            raise urllib.error.HTTPError(newurl, code, "a redirect away from https", headers, fp)
        return super().redirect_request(req, fp, code, msg, headers, newurl)


_opener = urllib.request.build_opener(_HttpsOnly)


def download(url):
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64)"})
    with _opener.open(req, timeout=TIMEOUT) as r:
        body = r.read(MAX_BYTES + 1)
    if len(body) > MAX_BYTES:
        raise ValueError("the feed is over 1 MB")
    return body


def _time(text):
    try:
        return int(email.utils.parsedate_to_datetime(text).timestamp())
    except (TypeError, ValueError, IndexError, OverflowError):
        return 0


def _text(el):
    return re.sub(r"\s+", " ", (el.text or "") if el is not None else "").strip()


def parse(body, limit):
    """The headlines in a Google News RSS feed: title (without the " - Source"
    Google adds), source, link, time. A feed with a DTD is refused: no
    entities, nothing from elsewhere."""
    if re.search(rb"<!DOCTYPE|<!ENTITY", body[:4096], re.I):
        raise ValueError("a feed with a DTD")
    root = ET.fromstring(body)
    out = []
    for item in root.iter("item"):
        title = _text(item.find("title"))
        link = _text(item.find("link"))
        source = _text(item.find("source"))
        if not title or not link.startswith("https://"):
            continue
        if source and title.endswith(" - " + source):
            title = title[: -len(source) - 3].rstrip()
        out.append({"title": title, "source": source, "link": link,
                    "time": _time(_text(item.find("pubDate")))})
        if len(out) >= limit:
            break
    return out


# --- every source ------------------------------------------------------------------------

def _key(title):
    """Two sources with the same story: the same title, give or take case,
    spaces and punctuation."""
    return re.sub(r"[\W_]+", " ", title.lower()).strip()


def merge(per_source, first_seen, now, quiet=()):
    """Every source's headlines in one list, newest first: a story two
    sources have is listed once, with both. Each says when it was first seen
    here (what the bar's dot counts); a source just added (in `quiet`)
    brings what it has as already seen: adding one isn't news."""
    items, by_key = [], {}
    for sid, heads in per_source:
        for h in heads:
            k = _key(h["title"])
            if k in by_key:
                if sid not in by_key[k]["from"]:
                    by_key[k]["from"].append(sid)
                continue
            item = dict(h, id=h["link"], **{"from": [sid]})
            item["first_seen"] = first_seen.get(h["link"], 0 if sid in quiet else now)
            by_key[k] = item
            items.append(item)
    items.sort(key=lambda i: (i["time"], i["first_seen"]), reverse=True)
    return items


def fetch(srcs, limit, previous, now=None, get=download):
    now = int(now or time.time())
    first_seen = dict((i["link"], i.get("first_seen", 0)) for i in previous.get("items", []))
    # Nothing fetched before: what comes now isn't news to anyone yet.
    if not previous.get("items"):
        first_seen = None
    old = {}
    for i in previous.get("items", []):
        for sid in i.get("from", []):
            old.setdefault(sid, []).append(i)

    def one(src):
        try:
            return source_id(src), parse(get(feed_url(src)), limit), ""
        except Exception as e:  # noqa: BLE001 — any failure is one source's
            return source_id(src), None, str(e)[:200] or e.__class__.__name__

    per_source, errors = [], {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
        for sid, heads, err in pool.map(one, srcs):
            if heads is None:
                errors[sid] = err
                # What it had last time stays, until it answers again.
                heads = [dict(title=i["title"], source=i["source"], link=i["link"], time=i["time"])
                         for i in old.get(sid, [])]
            per_source.append((sid, heads))
    added = set(source_id(s) for s in srcs) - set(old)
    items = merge(per_source, first_seen if first_seen is not None else {}, now, added)
    if first_seen is None:
        for i in items:
            i["first_seen"] = 0
    return {"fetched": now, "items": items, "errors": errors}


def show(limit, data=None):
    srcs = sources()
    data = data if data is not None else load_json(HEADLINES, {})
    wanted = set(source_id(s) for s in srcs)
    # A source taken away: its headlines go with it.
    items = []
    for i in data.get("items", []):
        frm = [s for s in i.get("from", []) if s in wanted]
        if frm:
            items.append(dict(i, **{"from": frm}))
    per = {}
    kept = []
    for i in items:
        if per.get(i["from"][0], 0) < limit:
            per[i["from"][0]] = per.get(i["from"][0], 0) + 1
            kept.append(i)
    return {"fetched": data.get("fetched", 0),
            "seen": load_json(SEEN, {}).get("at", 0),
            "sources": described(srcs),
            "items": kept,
            "errors": dict((k, v) for k, v in data.get("errors", {}).items() if k in wanted)}


# --- the browser ---------------------------------------------------------------------------

def _desktop_dirs():
    home = os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share")
    dirs = [home] + (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
    dirs += [os.path.join(HOME, ".local/share/flatpak/exports/share"), "/var/lib/flatpak/exports/share"]
    return [os.path.join(d, "applications") for d in dirs if d]


def browser_class(desktop_id, dirs=None):
    """The window class of a .desktop's app: its StartupWMClass, else its
    name (firefox.desktop: firefox). Opening a link doesn't bring the
    browser's window forward when it's on another workspace; this is what
    the shell looks for to go there."""
    desktop_id = os.path.basename(desktop_id or "").strip()
    if not desktop_id.endswith(".desktop"):
        return ""
    for d in dirs if dirs is not None else _desktop_dirs():
        try:
            with open(os.path.join(d, desktop_id), encoding="utf-8") as f:
                for line in f:
                    if line.startswith("["):
                        if line.strip() != "[Desktop Entry]":
                            break
                    elif line.startswith("StartupWMClass="):
                        return line.split("=", 1)[1].strip()
        except OSError:
            continue
        break
    return desktop_id[: -len(".desktop")]


def default_browser():
    try:
        out = subprocess.run(["xdg-settings", "get", "default-web-browser"], capture_output=True,
                             text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        out = ""
    return browser_class(out.strip())


# --- the command ---------------------------------------------------------------------------

def _limit(args):
    if "--limit" in args:
        try:
            return max(1, min(MAX_LIMIT, int(args[args.index("--limit") + 1])))
        except (IndexError, ValueError):
            pass
    return DEFAULT_LIMIT


USAGE = "usage: news show|fetch [--limit N] | sources | set-sources JSON | seen | editions | browser"


def main(argv):
    if not argv:
        sys.exit(USAGE)
    cmd, rest = argv[0], argv[1:]
    if cmd == "show":
        result = show(_limit(rest))
    elif cmd == "fetch":
        limit = _limit(rest)
        data = fetch(sources(), limit, load_json(HEADLINES, {}))
        save_json(HEADLINES, data)
        if not os.path.exists(SEEN):
            save_json(SEEN, {"at": data["fetched"]})
        result = show(limit, data)
    elif cmd == "sources":
        result = described(sources())
    elif cmd == "set-sources" and rest:
        try:
            raw = json.loads(rest[0])
        except ValueError:
            sys.exit("news: the sources aren't JSON")
        save_json(SOURCES, check_sources(raw))
        result = described(sources())
    elif cmd == "seen":
        now = int(time.time())
        save_json(SEEN, {"at": now})
        result = {"seen": now}
    elif cmd == "browser":
        result = {"class": default_browser()}
    elif cmd == "editions":
        result = [{"id": edition_id(c, l), "country": c, "lang": l, "hl": hl} for c, l, hl in EDITIONS]
    else:
        sys.exit(USAGE)
    json.dump(result, sys.stdout, ensure_ascii=False, separators=(",", ":"))
    sys.stdout.write("\n")


if __name__ == "__main__":
    main(sys.argv[1:])
