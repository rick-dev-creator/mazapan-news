// Generated by mazapan (plugin {{ plugin }}).
//
// The news: a sheet that comes in from the bar's right, under it, as tall
// as the screen, made for reading. On top, your sources as filters (all of
// them together, or one); below, the headlines, what came since you last
// looked first, each whole (never cut to one line) with its source and how
// long ago. A click or Enter opens it in the browser.
//
// ⚙ turns the sheet into your sources: pick a country in one of its
// languages, tap the sections you want from it (each tap adds or takes one
// away), or type a topic of your own.
//
// ↑ ↓ move, ← → change the filter, Enter opens, Ctrl+R looks for news now,
// Ctrl+S your sources, Esc goes back or closes; so does a click outside.

import QtQuick
import QtQuick.Layouts
import QtQuick.Controls as QQC
import QtQuick.Effects
import Quickshell
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"
import "../components/news"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null
  readonly property var ns: NewsService

  function toggle() { open ? close() : show() }
  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    editing = false
    // What's new right now stays marked until the sheet closes.
    seenAtOpen = ns.seen
    // Back within a few minutes (after reading one): where it was.
    if (Date.now() - closedAt > 5 * 60 * 1000) {
      list.currentIndex = -1
      list.positionViewAtBeginning()
    }
    open = true
    Qt.callLater(() => keys.forceActiveFocus())
  }
  function close() {
    if (editing) leaveSources()
    open = false
    closedAt = Date.now()
  }
  property double closedAt: 0

  Binding { target: NewsService; property: "panelOpen"; value: root.open }

  // --- what's shown --------------------------------------------------------------------

  property string filter: ""       // a source's id; "" all of them
  property int seenAtOpen: 0
  onFilterChanged: { list.currentIndex = -1; list.positionViewAtBeginning() }

  readonly property var filters: [""].concat(ns.sources.map(s => s.id))
  // A filter whose source was taken away: back to all.
  onFiltersChanged: if (!filters.includes(filter)) filter = ""

  function isNew(i) { return i.first_seen > seenAtOpen }
  // What came since you last looked, first; then the rest. Newest first in each.
  readonly property var rows: {
    const shown = ns.of(filter)
    return shown.filter(i => isNew(i)).concat(shown.filter(i => !isNew(i)))
  }
  readonly property int freshCount: rows.filter(i => isNew(i)).length
  readonly property var current: list.currentIndex >= 0 && list.currentIndex < rows.length ? rows[list.currentIndex] : null

  function step(d) {
    const i = filters.indexOf(filter)
    filter = filters[(i + d + filters.length) % filters.length]
  }

  readonly property var failed: Object.keys(ns.errors).filter(id => !filter || id === filter)

  // --- your sources ---------------------------------------------------------------------

  property bool editing: false
  property bool changed: false
  property string edition: ""      // the edition being added from
  readonly property int maxSources: 12

  function editSources() {
    ns.loadEditions()
    edition = ns.sources.length ? ns.sources[0].edition : ""
    editing = true
    changed = false
    Qt.callLater(() => { find.text = ""; find.forceActiveFocus() })
  }
  function leaveSources() {
    editing = false
    if (changed) ns.refresh()
    changed = false
    Qt.callLater(() => keys.forceActiveFocus())
  }

  function has(ed, topic, query) {
    return ns.sources.some(s => s.edition === ed && (query ? (s.query || "").toLowerCase() === query.toLowerCase() : s.topic === topic))
  }
  function save(list) { ns.setSources(list); changed = true }
  function toggleSection(ed, topic) {
    if (!ed) return
    if (has(ed, topic, "")) save(ns.sources.filter(s => !(s.edition === ed && s.topic === topic)))
    else if (ns.sources.length < maxSources) save(ns.sources.concat([{ edition: ed, topic: topic }]))
  }
  function addTopic(ed, words) {
    const q = words.replace(/\s+/g, " ").trim().slice(0, 80)
    if (!ed || !q || has(ed, "", q) || ns.sources.length >= maxSources) return
    save(ns.sources.concat([{ edition: ed, query: q }]))
  }
  function remove(sid) { save(ns.sources.filter(s => s.id !== sid)) }

  readonly property var editionRows: {
    const q = find.text.trim().toLowerCase()
    const all = ns.editions.map(e => Object.assign({ name: ns.country(e.country), language: ns.language(e.lang) }, e))
      .sort((a, b) => a.name.localeCompare(b.name))
    if (!q) return all
    return all.filter(e => [e.name, e.language, e.country, e.lang].some(s => s.toLowerCase().includes(q)))
  }
  readonly property var picked: ns.editions.find(e => e.id === edition) || null

  // Topics people often follow, in the edition's language.
  readonly property var suggestions: ({
    en: ["AI", "crypto", "video games", "space", "climate"],
    es: ["inteligencia artificial", "criptomonedas", "videojuegos", "espacio", "clima"],
    pt: ["inteligência artificial", "criptomoedas", "videogames", "espaço", "clima"],
    fr: ["intelligence artificielle", "cryptomonnaies", "jeux vidéo", "espace", "climat"],
    de: ["künstliche Intelligenz", "Kryptowährungen", "Videospiele", "Raumfahrt", "Klima"],
    it: ["intelligenza artificiale", "criptovalute", "videogiochi", "spazio", "clima"],
    nl: ["kunstmatige intelligentie", "crypto", "games", "ruimtevaart", "klimaat"],
    ja: ["人工知能", "暗号資産", "ゲーム", "宇宙", "気候"],
    ko: ["인공지능", "암호화폐", "게임", "우주", "기후"],
    "zh-Hans": ["人工智能", "加密货币", "游戏", "太空", "气候"],
    "zh-Hant": ["人工智慧", "加密貨幣", "遊戲", "太空", "氣候"]
  })
  function suggest(lang) {
    if (!lang) return []
    return suggestions[lang] || suggestions[lang.split("-")[0]] || suggestions.en
  }

  // --- the window ------------------------------------------------------------------------

  PanelWindow {
    id: win
    visible: root.open || sheet.opacity > 0.01
    screen: root.screenAtOpen
    anchors.top: true
    anchors.bottom: true
    anchors.left: true
    anchors.right: true
    color: "transparent"
    // Below the bar, never over it.
    exclusionMode: ExclusionMode.Normal
    exclusiveZone: 0
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-news"
    WlrLayershell.keyboardFocus: root.open ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.None
    mask: Region { item: root.open ? win.contentItem : null }

    // A click anywhere else closes it.
    MouseArea {
      anchors.fill: parent
      enabled: root.open
      acceptedButtons: Qt.AllButtons
      onPressed: root.close()
    }

    RectangularShadow {
      anchors.fill: sheet
      radius: sheet.radius
      blur: 40
      offset.y: 14
      opacity: sheet.opacity
      color: Qt.rgba(0, 0, 0, Theme.mode === "light" ? 0.16 : 0.42)
    }

    Rectangle {
      id: sheet
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      anchors.margins: Theme.gapOut
      anchors.rightMargin: Theme.gapOut - (root.open ? 0 : 24)
      width: Math.min(parent.width - 32, 600)
      color: Theme.bg
      border.width: 1
      border.color: Theme.border
      radius: Theme.radius
      clip: true

      opacity: root.open ? 1 : 0
      Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
      Behavior on anchors.rightMargin { enabled: Theme.motion; NumberAnimation { duration: 260; easing.type: Easing.OutCubic } }

      MouseArea {
        anchors.fill: parent
        acceptedButtons: Qt.AllButtons
        onPressed: if (!root.editing) keys.forceActiveFocus()
      }

      // A glow of the accent behind the header.
      Rectangle {
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        height: 170
        gradient: Gradient {
          GradientStop { position: 0; color: Qt.alpha(Theme.accent, Theme.mode === "light" ? 0.08 : 0.12) }
          GradientStop { position: 1; color: "transparent" }
        }
      }

      // The keys, wherever the focus is in the reading view.
      Item {
        id: keys
        focus: true
        Keys.onPressed: event => {
          const ctrl = event.modifiers & Qt.ControlModifier
          if (event.key === Qt.Key_Escape) root.close()
          else if (event.key === Qt.Key_Down || event.key === Qt.Key_J) list.currentIndex = Math.min(root.rows.length - 1, list.currentIndex + 1)
          else if (event.key === Qt.Key_Up || event.key === Qt.Key_K) list.currentIndex = Math.max(root.rows.length ? 0 : -1, list.currentIndex - 1)
          else if (event.key === Qt.Key_Right || event.key === Qt.Key_Tab) root.step(1)
          else if (event.key === Qt.Key_Left || event.key === Qt.Key_Backtab) root.step(-1)
          else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) { if (root.current) root.read(root.current) }
          else if (ctrl && event.key === Qt.Key_R) ns.refresh()
          else if (ctrl && event.key === Qt.Key_S) root.editSources()
          else if (event.key === Qt.Key_Home) list.currentIndex = root.rows.length ? 0 : -1
          else return
          event.accepted = true
        }
      }

      // ============================== reading ==============================
      ColumnLayout {
        anchors.fill: parent
        spacing: 0
        visible: !root.editing

        // --- the header ---------------------------------------------------------------
        RowLayout {
          Layout.fillWidth: true
          Layout.leftMargin: 22
          Layout.rightMargin: 18
          Layout.topMargin: 20
          spacing: 14

          Logo {}

          ColumnLayout {
            Layout.fillWidth: true
            spacing: 1
            Text {
              text: {{ tq "title" }}
              color: Theme.fg
              font.family: Theme.fontMono
              font.pixelSize: Theme.fontSize * 1.75
              font.bold: true
            }
            Text {
              Layout.fillWidth: true
              text: ns.loading ? {{ tq "looking" }}
                : !ns.fetched ? (Online.online ? "" : {{ tq "offline" }})
                : [{{ tq "updated" }}.arg(ns.ago(ns.fetched)),
                   root.freshCount ? {{ tq "fresh" }}.arg(root.freshCount) : "",
                   Online.online ? "" : {{ tq "offline.short" }}].filter(s => s).join("  ·  ")
              color: Online.online ? Theme.fgMuted : Theme.warning
              font.family: Theme.fontMono
              font.pixelSize: Theme.fontSize * 1.02
              elide: Text.ElideRight
            }
          }

          Act {
            glyph: String.fromCodePoint(0xF0450)
            spinning: ns.loading && Theme.motion
            onClicked: ns.refresh()
          }
          Act {
            glyph: String.fromCodePoint(0xF0493)
            onClicked: root.editSources()
          }
        }

        // --- your sources, as filters ----------------------------------------------------
        Flickable {
          id: chips
          Layout.fillWidth: true
          Layout.topMargin: 16
          Layout.leftMargin: 22
          Layout.rightMargin: 22
          Layout.preferredHeight: 30
          contentWidth: chipRow.implicitWidth
          flickableDirection: Flickable.HorizontalFlick
          boundsBehavior: Flickable.StopAtBounds
          clip: true
          visible: ns.sources.length > 1
          Row {
            id: chipRow
            spacing: 6
            Repeater {
              model: root.filters
              Chip {
                required property string modelData
                readonly property var src: ns.source(modelData)
                lead: src ? ns.flag(src.country) : ""
                text: src ? ns.topicOf(src) : {{ tq "all" }}
                count: ns.of(modelData).length
                checked: root.filter === modelData
                warn: !!ns.errors[modelData]
                onClicked: { root.filter = modelData; keys.forceActiveFocus() }
                onCheckedChanged: if (checked) chips.contentX = Math.max(0, Math.min(x - 40, chips.contentWidth - chips.width))
              }
            }
          }
        }

        // --- what couldn't be fetched ---------------------------------------------------------
        Text {
          Layout.fillWidth: true
          Layout.topMargin: 10
          Layout.leftMargin: 24
          Layout.rightMargin: 24
          visible: root.failed.length > 0 && Online.online && !ns.loading
          text: {{ tq "failed" }}.arg(root.failed.map(id => { const s = ns.source(id); return s ? ns.flag(s.country) + " " + ns.topicOf(s) : id }).join(", "))
          color: Theme.warning
          font.family: Theme.fontMono
          font.pixelSize: Theme.fontSize * 0.95
          wrapMode: Text.Wrap
          textFormat: Text.PlainText
        }

        // --- the headlines -----------------------------------------------------------------
        ListView {
          id: list
          Layout.fillWidth: true
          Layout.fillHeight: true
          Layout.topMargin: 10
          Layout.leftMargin: 12
          Layout.rightMargin: 12
          clip: true
          spacing: 2
          currentIndex: -1
          model: root.rows
          boundsBehavior: Flickable.StopAtBounds
          highlightFollowsCurrentItem: false
          reuseItems: true
          QQC.ScrollBar.vertical: QQC.ScrollBar { policy: QQC.ScrollBar.AsNeeded }
          onCurrentIndexChanged: if (currentIndex >= 0) positionViewAtIndex(currentIndex, ListView.Contain)

          delegate: Column {
            id: cell
            required property var modelData
            required property int index
            width: list.width
            // "New" over the first of what came since you last looked, and
            // "Earlier" over the rest, when there's both.
            Heading {
              width: cell.width
              visible: root.freshCount > 0 && (cell.index === 0 || cell.index === root.freshCount)
              text: cell.index === 0 ? {{ tq "h.new" }}.arg(root.freshCount) : {{ tq "h.earlier" }}
            }
            Headline {
              width: cell.width
              item: cell.modelData
              fresh: root.isNew(cell.modelData)
              current: cell.ListView.isCurrentItem
              onPicked: { list.currentIndex = cell.index; keys.forceActiveFocus() }
            }
          }

          // Nothing to show.
          ColumnLayout {
            anchors.centerIn: parent
            width: parent.width - 40
            visible: root.rows.length === 0
            spacing: 10
            Text {
              Layout.alignment: Qt.AlignHCenter
              text: String.fromCodePoint(ns.loading ? 0xF0450 : Online.online ? 0xF0395 : 0xF092E)
              color: Theme.fgSubtle
              font.family: Theme.fontMono
              font.pixelSize: 54
              opacity: 0.6
            }
            Text {
              Layout.alignment: Qt.AlignHCenter
              Layout.fillWidth: true
              horizontalAlignment: Text.AlignHCenter
              wrapMode: Text.Wrap
              text: ns.loading || !ns.loaded ? {{ tq "looking" }} : !Online.online ? {{ tq "offline" }} : {{ tq "empty" }}
              color: Theme.fg
              font.family: Theme.fontMono
              font.pixelSize: Theme.fontSize * 1.3
              font.bold: true
            }
          }
        }

        Caption {
          Layout.fillWidth: true
          Layout.preferredHeight: 40
          Layout.leftMargin: 22
          Layout.rightMargin: 22
          verticalAlignment: Text.AlignVCenter
          text: {{ tq "keys" }}
          font.letterSpacing: 0
          color: Theme.fgSubtle
          horizontalAlignment: Text.AlignHCenter
          elide: Text.ElideRight
        }
      }

      // ============================== your sources ==============================
      ColumnLayout {
        anchors.fill: parent
        spacing: 0
        visible: root.editing

        RowLayout {
          Layout.fillWidth: true
          Layout.leftMargin: 18
          Layout.rightMargin: 18
          Layout.topMargin: 20
          spacing: 12
          Act {
            glyph: String.fromCodePoint(0xF004D)
            onClicked: root.leaveSources()
          }
          ColumnLayout {
            Layout.fillWidth: true
            spacing: 1
            Text {
              text: {{ tq "s.title" }}
              color: Theme.fg
              font.family: Theme.fontMono
              font.pixelSize: Theme.fontSize * 1.6
              font.bold: true
            }
            Text {
              text: ns.sources.length >= root.maxSources ? {{ tq "s.full" }}.arg(root.maxSources)
                : {{ tq "s.count" }}.arg(ns.sources.length).arg(root.maxSources)
              color: ns.sources.length >= root.maxSources ? Theme.warning : Theme.fgMuted
              font.family: Theme.fontMono
              font.pixelSize: Theme.fontSize * 1.02
            }
          }
        }

        Flickable {
          id: form
          Layout.fillWidth: true
          Layout.fillHeight: true
          Layout.topMargin: 12
          contentHeight: formCol.implicitHeight + 24
          boundsBehavior: Flickable.StopAtBounds
          clip: true
          QQC.ScrollBar.vertical: QQC.ScrollBar { policy: QQC.ScrollBar.AsNeeded }

          ColumnLayout {
            id: formCol
            x: 22
            width: form.width - 44
            spacing: 10

            // --- what you have ---
            Caption { text: {{ tq "s.yours" }}.toUpperCase() }
            Repeater {
              model: ns.sources
              SourceRow {
                required property var modelData
                Layout.fillWidth: true
                src: modelData
                onRemoved: root.remove(modelData.id)
                onPicked: { root.edition = modelData.edition; root.showPicked() }
              }
            }
            Text {
              visible: ns.sources.length === 0
              text: {{ tq "s.none" }}
              color: Theme.fgMuted
              font.family: Theme.fontMono
              font.pixelSize: Theme.fontSize * 1.05
              wrapMode: Text.Wrap
              Layout.fillWidth: true
            }

            Rule { Layout.fillWidth: true; Layout.topMargin: 8; Layout.bottomMargin: 4 }

            // --- 1. where from ---
            Caption { text: {{ tq "s.where" }}.toUpperCase() }
            Rectangle {
              Layout.fillWidth: true
              Layout.preferredHeight: 42
              radius: Theme.radius
              color: Theme.surface
              border.width: find.activeFocus ? 2 : 1
              border.color: find.activeFocus ? Theme.accent : Theme.border
              RowLayout {
                anchors.fill: parent
                anchors.leftMargin: 14
                anchors.rightMargin: 12
                spacing: 10
                Text {
                  text: String.fromCodePoint(0xF0349)
                  color: find.activeFocus ? Theme.accentText : Theme.fgMuted
                  font.family: Theme.fontMono
                  font.pixelSize: 16
                }
                TextInput {
                  id: find
                  Layout.fillWidth: true
                  color: Theme.fg
                  selectionColor: Theme.selection
                  selectedTextColor: Theme.fg
                  font.family: Theme.fontMono
                  font.pixelSize: Theme.fontSize * 1.25
                  clip: true
                  Text {
                    anchors.fill: parent
                    verticalAlignment: Text.AlignVCenter
                    visible: find.text === ""
                    text: {{ tq "s.find" }}
                    color: Theme.fgSubtle
                    font: find.font
                    elide: Text.ElideRight
                  }
                  onTextChanged: if (root.editionRows.length) editions.currentIndex = 0
                  Keys.onPressed: event => {
                    if (event.key === Qt.Key_Escape) { if (find.text) find.text = ""; else root.leaveSources() }
                    else if (event.key === Qt.Key_Down) editions.currentIndex = Math.min(root.editionRows.length - 1, editions.currentIndex + 1)
                    else if (event.key === Qt.Key_Up) editions.currentIndex = Math.max(0, editions.currentIndex - 1)
                    else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {
                      const e = root.editionRows[editions.currentIndex]
                      if (e) { root.edition = e.id; find.text = "" ; root.showPicked() }
                    } else return
                    event.accepted = true
                  }
                }
              }
            }
            Rectangle {
              Layout.fillWidth: true
              Layout.preferredHeight: 196
              radius: Theme.radius
              color: Theme.bgAlt
              border.width: 1
              border.color: Theme.border
              ListView {
                id: editions
                anchors.fill: parent
                anchors.margins: 4
                clip: true
                model: root.editionRows
                currentIndex: 0
                boundsBehavior: Flickable.StopAtBounds
                QQC.ScrollBar.vertical: QQC.ScrollBar { policy: QQC.ScrollBar.AsNeeded }
                onCurrentIndexChanged: positionViewAtIndex(currentIndex, ListView.Contain)
                delegate: EditionRow {
                  required property var modelData
                  required property int index
                  width: editions.width
                  ed: modelData
                  chosen: root.edition === modelData.id
                  current: editions.currentIndex === index && find.activeFocus
                  onPicked: { root.edition = modelData.id; editions.currentIndex = index }
                }
              }
            }

            // --- 2. what from there ---
            Caption {
              Layout.topMargin: 8
              text: root.picked ? {{ tq "s.what" }}.arg(ns.flag(root.picked.country) + " " + ns.country(root.picked.country) + " · " + ns.language(root.picked.lang)).toUpperCase()
                : {{ tq "s.pick" }}.toUpperCase()
              wrapMode: Text.Wrap
              Layout.fillWidth: true
            }
            Flow {
              id: sections
              Layout.fillWidth: true
              spacing: 6
              enabled: !!root.picked
              opacity: enabled ? 1 : 0.4
              Repeater {
                model: ns.sectionOrder
                Chip {
                  required property string modelData
                  text: ns.topics[modelData]
                  checked: root.has(root.edition, modelData, "")
                  lead: checked ? String.fromCodePoint(0xF012C) : String.fromCodePoint(0xF0415)
                  glyphLead: true
                  onClicked: root.toggleSection(root.edition, modelData)
                }
              }
            }

            // --- 3. or a topic of your own ---
            Caption { Layout.topMargin: 8; text: {{ tq "s.topic" }}.toUpperCase() }
            Rectangle {
              Layout.fillWidth: true
              Layout.preferredHeight: 42
              radius: Theme.radius
              color: Theme.surface
              border.width: topic.activeFocus ? 2 : 1
              border.color: topic.activeFocus ? Theme.accent : Theme.border
              enabled: !!root.picked
              opacity: enabled ? 1 : 0.4
              RowLayout {
                anchors.fill: parent
                anchors.leftMargin: 14
                anchors.rightMargin: 6
                spacing: 10
                TextInput {
                  id: topic
                  Layout.fillWidth: true
                  color: Theme.fg
                  selectionColor: Theme.selection
                  selectedTextColor: Theme.fg
                  font.family: Theme.fontMono
                  font.pixelSize: Theme.fontSize * 1.25
                  maximumLength: 80
                  clip: true
                  Text {
                    anchors.fill: parent
                    verticalAlignment: Text.AlignVCenter
                    visible: topic.text === ""
                    text: {{ tq "s.topic.hint" }}.arg(root.suggest(root.picked ? root.picked.lang : "").slice(0, 2).join(", "))
                    color: Theme.fgSubtle
                    font: topic.font
                    elide: Text.ElideRight
                  }
                  Keys.onPressed: event => {
                    if (event.key === Qt.Key_Escape) { if (topic.text) topic.text = ""; else root.leaveSources() }
                    else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) { root.addTopic(root.edition, topic.text); topic.text = "" }
                    else return
                    event.accepted = true
                  }
                }
                Act {
                  glyph: String.fromCodePoint(0xF0415)
                  text: {{ tq "s.add" }}
                  tone: Theme.accentText
                  visible: topic.text.trim() !== ""
                  onClicked: { root.addTopic(root.edition, topic.text); topic.text = "" }
                }
              }
            }
            Flow {
              Layout.fillWidth: true
              spacing: 6
              visible: !!root.picked
              Repeater {
                model: root.suggest(root.picked ? root.picked.lang : "")
                Chip {
                  required property string modelData
                  text: modelData
                  checked: root.has(root.edition, "", modelData)
                  lead: checked ? String.fromCodePoint(0xF012C) : String.fromCodePoint(0xF0415)
                  glyphLead: true
                  onClicked: {
                    if (checked) root.save(ns.sources.filter(s => !(s.edition === root.edition && (s.query || "").toLowerCase() === modelData.toLowerCase())))
                    else root.addTopic(root.edition, modelData)
                  }
                }
              }
            }
          }
        }

        Caption {
          Layout.fillWidth: true
          Layout.preferredHeight: 40
          Layout.leftMargin: 22
          Layout.rightMargin: 22
          verticalAlignment: Text.AlignVCenter
          text: {{ tq "s.keys" }}
          font.letterSpacing: 0
          color: Theme.fgSubtle
          horizontalAlignment: Text.AlignHCenter
          elide: Text.ElideRight
        }
      }
    }
  }

  // A headline opened: in the browser, which comes forward; the sheet goes
  // away, and opens again where it was.
  function read(item) {
    ns.openUrl(item.link)
    close()
  }

  // An edition picked from your sources: shown in the list.
  function showPicked() {
    const i = editionRows.findIndex(e => e.id === edition)
    if (i >= 0) editions.currentIndex = i
  }

  // --- pieces of this panel -------------------------------------------------------------------

  component Logo: Rectangle {
    Layout.preferredWidth: 40
    Layout.preferredHeight: 40
    radius: Math.min(Theme.radius * 1.5, 12)
    gradient: Gradient {
      GradientStop { position: 0; color: Qt.lighter(Theme.accent, 1.12) }
      GradientStop { position: 1; color: Theme.accentDeep }
    }
    Text {
      anchors.centerIn: parent
      text: String.fromCodePoint(0xF0395)
      color: Theme.accentFg
      font.family: Theme.fontMono
      font.pixelSize: 20
    }
  }

  // A rounded label you can pick: a source as a filter, a section to follow.
  component Chip: Rectangle {
    id: chip
    property string lead: ""         // a flag, or a glyph (glyphLead)
    property bool glyphLead: false
    property string text: ""
    property int count: -1
    property bool checked: false
    property bool warn: false
    signal clicked()
    implicitHeight: 30
    implicitWidth: chipRow.implicitWidth + 24
    radius: Theme.radius > 0 ? 15 : 0
    color: checked ? Qt.alpha(Theme.accent, 0.18) : chipHover.hovered ? Theme.surfaceRaised : Theme.surface
    border.width: 1
    border.color: checked ? Qt.alpha(Theme.accent, 0.7) : Theme.border
    Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 130 } }
    Row {
      id: chipRow
      anchors.centerIn: parent
      spacing: 7
      Text {
        anchors.verticalCenter: parent.verticalCenter
        visible: chip.lead !== ""
        text: chip.lead
        color: chip.checked ? Theme.accentText : Theme.fgMuted
        font.family: chip.glyphLead ? Theme.fontMono : Theme.fontUi
        font.pixelSize: chip.glyphLead ? 13 : Theme.fontSize * 1.15
      }
      Text {
        anchors.verticalCenter: parent.verticalCenter
        text: chip.text
        color: chip.checked ? Theme.fg : Theme.fgMuted
        font.family: Theme.fontMono
        font.pixelSize: Theme.fontSize * 0.98
        font.bold: chip.checked
        textFormat: Text.PlainText
      }
      Text {
        anchors.verticalCenter: parent.verticalCenter
        visible: chip.count >= 0 || chip.warn
        text: chip.warn ? "!" : chip.count
        color: chip.warn ? Theme.warning : Theme.fgSubtle
        font.family: Theme.fontMono
        font.pixelSize: Theme.fontSize * 0.88
      }
    }
    HoverHandler { id: chipHover; cursorShape: Qt.PointingHandCursor }
    TapHandler { onTapped: chip.clicked() }
  }

  // A round button with a glyph; a word beside it when it has one.
  component Act: Rectangle {
    id: act
    property string glyph: ""
    property string text: ""
    property color tone: Theme.fg
    property bool spinning: false
    signal clicked()
    implicitHeight: 32
    implicitWidth: text ? actRow.implicitWidth + 22 : 32
    radius: Theme.radius > 0 ? 16 : 0
    color: actHover.hovered ? Qt.alpha(tone, 0.14) : Qt.alpha(Theme.fg, 0.05)
    border.width: 1
    border.color: actHover.hovered ? Qt.alpha(tone, 0.6) : Theme.border
    Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 130 } }
    Row {
      id: actRow
      anchors.centerIn: parent
      spacing: 6
      Text {
        id: actGlyph
        anchors.verticalCenter: parent.verticalCenter
        text: act.glyph
        color: act.tone
        font.family: Theme.fontMono
        font.pixelSize: 15
        RotationAnimation on rotation {
          running: act.spinning
          from: 0; to: 360; duration: 900
          loops: Animation.Infinite
          onRunningChanged: if (!running) actGlyph.rotation = 0
        }
      }
      Text {
        anchors.verticalCenter: parent.verticalCenter
        visible: act.text !== ""
        text: act.text
        color: act.tone
        font.family: Theme.fontMono
        font.pixelSize: Theme.fontSize * 0.98
      }
    }
    HoverHandler { id: actHover; cursorShape: Qt.PointingHandCursor }
    TapHandler { onTapped: act.clicked() }
  }

  // "New · 5", "Earlier": over a run of headlines.
  component Heading: Item {
    property alias text: label.text
    implicitHeight: visible ? 34 : 0
    Caption {
      id: label
      anchors.left: parent.left
      anchors.leftMargin: 12
      anchors.bottom: parent.bottom
      anchors.bottomMargin: 6
      color: Theme.fgSubtle
    }
  }

  // A headline: whole, in the reading font, its source and age below.
  component Headline: Rectangle {
    id: card
    property var item: ({})
    property bool fresh: false
    property bool current: false
    signal picked()
    readonly property var src: ns.source(item.from ? item.from[0] : "")
    readonly property bool hot: current || cardHover.hovered

    implicitHeight: body.implicitHeight + 24
    radius: Theme.radius
    color: current ? Qt.alpha(Theme.accent, 0.10) : cardHover.hovered ? Theme.surface : "transparent"
    border.width: current ? 1 : 0
    border.color: Qt.alpha(Theme.accent, 0.55)
    Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 120 } }

    // New since you last looked.
    Rectangle {
      visible: card.fresh
      x: 8
      y: 12 + title.font.pixelSize * 0.55
      width: 6
      height: 6
      radius: 3
      color: Theme.accent
    }

    ColumnLayout {
      id: body
      x: 22
      y: 12
      width: parent.width - 22 - 14
      spacing: 6
      Text {
        id: title
        Layout.fillWidth: true
        text: card.item.title || ""
        color: Theme.fg
        font.family: Theme.fontUi
        font.pixelSize: Theme.fontSize * 1.3
        lineHeight: 1.18
        wrapMode: Text.Wrap
        maximumLineCount: 4
        elide: Text.ElideRight
        textFormat: Text.PlainText
      }
      RowLayout {
        Layout.fillWidth: true
        spacing: 8
        Text {
          text: card.item.source || ""
          color: card.hot ? Theme.accentText : Theme.fgMuted
          font.family: Theme.fontMono
          font.pixelSize: Theme.fontSize * 0.95
          font.bold: true
          elide: Text.ElideRight
          Layout.maximumWidth: card.width * 0.45
          textFormat: Text.PlainText
        }
        // Which of your sources, when they're all shown together.
        Text {
          visible: root.filter === "" && !!card.src && ns.sources.length > 1
          text: card.src ? (ns.flag(card.src.country) + " " + ns.topicOf(card.src)) : ""
          color: Theme.fgSubtle
          font.family: Theme.fontMono
          font.pixelSize: Theme.fontSize * 0.92
          elide: Text.ElideRight
          Layout.maximumWidth: card.width * 0.35
          textFormat: Text.PlainText
        }
        Item { Layout.fillWidth: true }
        Text {
          text: ns.ago(card.item.time)
          color: Theme.fgSubtle
          font.family: Theme.fontMono
          font.pixelSize: Theme.fontSize * 0.92
        }
      }
    }

    HoverHandler { id: cardHover; cursorShape: Qt.PointingHandCursor }
    TapHandler {
      onTapped: { card.picked(); root.read(card.item) }
    }
  }

  // One of your sources, in the list of them.
  component SourceRow: Rectangle {
    id: srow
    property var src: ({})
    signal removed()
    signal picked()
    implicitHeight: 44
    radius: Theme.radius
    color: srowHover.hovered ? Theme.surfaceRaised : Theme.surface
    border.width: 1
    border.color: root.edition === src.edition ? Qt.alpha(Theme.accent, 0.5) : Theme.border
    RowLayout {
      anchors.fill: parent
      anchors.leftMargin: 14
      anchors.rightMargin: 6
      spacing: 10
      Text {
        text: ns.flag(srow.src.country)
        font.family: Theme.fontUi
        font.pixelSize: Theme.fontSize * 1.4
      }
      Text {
        text: ns.topicOf(srow.src)
        color: Theme.fg
        font.family: Theme.fontMono
        font.pixelSize: Theme.fontSize * 1.1
        font.bold: true
        font.italic: !!srow.src.query
        elide: Text.ElideRight
        Layout.maximumWidth: srow.width * 0.45
        textFormat: Text.PlainText
      }
      Text {
        Layout.fillWidth: true
        text: ns.country(srow.src.country) + " · " + ns.language(srow.src.lang)
        color: Theme.fgMuted
        font.family: Theme.fontMono
        font.pixelSize: Theme.fontSize * 0.95
        elide: Text.ElideRight
      }
      Act {
        glyph: String.fromCodePoint(0xF0156)
        tone: Theme.danger
        onClicked: srow.removed()
      }
    }
    HoverHandler { id: srowHover; cursorShape: Qt.PointingHandCursor }
    TapHandler { onTapped: srow.picked() }
  }

  // An edition, in the list to pick from.
  component EditionRow: Rectangle {
    id: erow
    property var ed: ({})
    property bool chosen: false
    property bool current: false
    signal picked()
    implicitHeight: 36
    radius: Theme.radius
    color: chosen ? Qt.alpha(Theme.accent, 0.16) : current || erowHover.hovered ? Theme.surface : "transparent"
    RowLayout {
      anchors.fill: parent
      anchors.leftMargin: 10
      anchors.rightMargin: 12
      spacing: 10
      Text {
        text: ns.flag(erow.ed.country)
        font.family: Theme.fontUi
        font.pixelSize: Theme.fontSize * 1.3
      }
      Text {
        Layout.fillWidth: true
        text: erow.ed.name
        color: erow.chosen ? Theme.fg : Theme.fg
        font.family: Theme.fontMono
        font.pixelSize: Theme.fontSize * 1.05
        font.bold: erow.chosen
        elide: Text.ElideRight
      }
      Text {
        text: erow.ed.language
        color: Theme.fgMuted
        font.family: Theme.fontUi
        font.pixelSize: Theme.fontSize * 1.0
      }
      Text {
        visible: erow.chosen
        text: String.fromCodePoint(0xF012C)
        color: Theme.accentText
        font.family: Theme.fontMono
        font.pixelSize: 14
      }
    }
    HoverHandler { id: erowHover; cursorShape: Qt.PointingHandCursor }
    TapHandler { onTapped: erow.picked() }
  }
}
