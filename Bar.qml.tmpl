// Generated by mazapan (plugin {{ plugin }}): the news, in the bar.
//
// Only its mark, quiet: no headlines going by. A dot when there's news since
// you last looked (with `dot` on); the mark turns faint while it looks. A
// click opens the panel; a right click looks for news now.

import QtQuick
import Quickshell
import qs
import "../../components/kit"
import "../../components/news"

BarItem {
  id: root

  readonly property bool fresh: NewsService.settings.dot && NewsService.fresh > 0
  shown: NewsService.settings.bar
  open: NewsService.panelOpen
  acceptedButtons: Qt.LeftButton | Qt.RightButton
  onClicked: mouse => {
    if (mouse.button === Qt.RightButton) NewsService.refresh()
    else Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "panel", "news"])
  }

  Item {
    anchors.verticalCenter: parent.verticalCenter
    width: mark.implicitWidth
    height: mark.implicitHeight
    Text {
      id: mark
      text: String.fromCodePoint(0xF0395)
      color: root.fresh ? Theme.fg : Theme.fgMuted
      opacity: NewsService.loading ? 0.5 : 1
      font.family: Theme.fontMono
      font.pixelSize: Theme.fontSize * 1.35
      Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 300 } }
    }
    Rectangle {
      visible: root.fresh
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.rightMargin: -3
      anchors.topMargin: 1
      width: 6
      height: 6
      radius: 3
      color: Theme.accent
    }
  }
}
